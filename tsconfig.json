{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "cloudflare.config.ts", "wrangler.config.ts", "worker-configuration.d.ts", ".cloudflare/types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "public"]
}
